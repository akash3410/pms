# ---------------------------------------------------------------------------
# POMS frontend — example environment file.
# Copy to `.env` (or `.env.local`) and adjust. Do not commit real secrets.
# ---------------------------------------------------------------------------

# Base URL of the Django REST API, including the version prefix.
# Leave as `/api/v1` to use the Vite dev proxy (recommended for local dev).
# For a separately hosted backend use the full origin, e.g.
#   VITE_API_BASE_URL=https://poms.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Development-only: where the Vite proxy forwards /api requests.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Public web URL used to build the links placed inside invitation / password
# reset emails. Informational only — the backend composes the emails.
VITE_APP_NAME=POMS
