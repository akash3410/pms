# ---------------------------------------------------------------------------
# POMS backend - example environment file.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-strong-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LOG_LEVEL=INFO
POMS_LOG_LEVEL=INFO
TIME_ZONE=Asia/Dhaka

# PostgreSQL
POSTGRES_DB=poms
POSTGRES_USER=poms
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# Pagination
PAGE_SIZE=20

# JWT lifetimes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
ROTATE_REFRESH_TOKENS=True
BLACKLIST_AFTER_ROTATION=True

# Order-card images
MAX_ORDER_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp

# CORS / CSRF (comma-separated origins; leave empty for same-origin)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Production-only hardening
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000